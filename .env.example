# 复制为 .env 后只在服务器上填写。不要把真实密钥提交到仓库。
# demo：本地验收。sandbox / production 禁止演示角色切换。
# NODE_ENV=production 时不能使用 APP_ENV=demo。

APP_ENV=demo
# SESSION_SECRET=
# PUBLIC_BASE_URL=https://mileage.example.com

# 以下留空即视为未配置。未配置时真实登录、建单和回调都会被拒绝。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_TENANT_KEY=
# FEISHU_REDIRECT_URI=https://mileage.example.com/api/auth/feishu/callback
# FEISHU_OAUTH_SCOPES=
# FEISHU_OAUTH_PKCE=0
# FEISHU_APPROVAL_CODE=
# FEISHU_WIDGET_CLAIM_NO=
# FEISHU_WIDGET_AMOUNT=
# FEISHU_WIDGET_DISTANCE=
# FEISHU_WIDGET_SUMMARY=
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_EVENT_MAX_SKEW_SECONDS=28800
# FEISHU_BOOTSTRAP_ADMIN_OPEN_ID=
# DATABASE_PATH=
# MAX_TRIP_METERS=800000
